{
  "name": "ts-server",
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "build": "npx tsc --outDir dist",
    "dev": "concurrently \"npx tsc --watch --outDir dist\" \"nodemon -q -r tsconfig-paths/register dist/src/index.js\"",
    "test": "echo \"Error: no test specified\" && exit 0",
    "clean": "rm -rf dist && echo 'Done.'",
    "bund": "bun --watch run src/index.ts"
  },
